# Add your Anthropic API key to enable real AI text generation
# (world building, magic system, characters, plot, opening scene).
# Without it, Mythforge automatically falls back to a local
# template-based generator so the app still works out of the box.
ANTHROPIC_API_KEY=

# Optional: override the text model used for generation (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Add your OpenAI API key to enable real AI image generation
# (world map + character portraits). Without it, Mythforge shows a
# tasteful placeholder graphic instead of an error.
OPENAI_API_KEY=

# Optional: override the image model used for generation (defaults to gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1
